<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FaceFitKiosk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/facefit_teal</item>
        <item name="colorPrimaryVariant">@color/facefit_teal_dark</item>
        <item name="colorSecondary">@color/facefit_teal</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/facefit_surface_soft</item>
        <item name="android:navigationBarColor">@color/facefit_surface_soft</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Widget.FaceFit.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/facefit_teal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.FaceFit.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item>
        <item name="boxStrokeColor">@color/facefit_border</item>
        <item name="hintTextColor">@color/facefit_ink_muted</item>
        <item name="errorTextColor">@color/facefit_error</item>
    </style>
</resources>

