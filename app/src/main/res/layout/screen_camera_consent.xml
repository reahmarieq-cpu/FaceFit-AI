<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="560dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="0.88"
                android:background="@drawable/bg_teal_panel"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:minHeight="500dp"
                android:orientation="vertical"
                android:padding="54dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/consent_privacy_eyebrow"
                    android:textColor="#9ED7DF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/consent_privacy_title"
                    android:textColor="@android:color/white"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/consent_privacy_body"
                    android:textColor="#C7E4EA"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1.12"
                android:background="@drawable/bg_white_panel"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:minHeight="500dp"
                android:orientation="vertical"
                android:padding="48dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/consent_eyebrow"
                    android:textColor="@color/facefit_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/consent_title"
                    android:textColor="@color/facefit_ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/consent_body"
                    android:textColor="@color/facefit_ink_muted"
                    android:textSize="15sp" />

                <include
                    android:id="@+id/cameraAccessRow"
                    layout="@layout/view_consent_row"
                    android:layout_marginTop="22dp" />

                <include
                    android:id="@+id/facialProcessingRow"
                    layout="@layout/view_consent_row"
                    android:layout_marginTop="16dp" />

                <include
                    android:id="@+id/sessionDataRow"
                    layout="@layout/view_consent_row"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/agreeButton"
                        style="@style/Widget.FaceFit.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:minWidth="190dp"
                        android:text="@string/consent_agree_button" />

                    <TextView
                        android:id="@+id/cancelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_outline_button"
                        android:gravity="center"
                        android:minWidth="120dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/consent_cancel_button"
                        android:textColor="@color/facefit_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

