<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="560dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_panel"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="46dp">

            <TextView
                android:id="@+id/processingEyebrowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/processing_eyebrow"
                android:textColor="@color/facefit_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/processingProgress"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="24dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/processingTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/processing_analyzing_title"
                android:textColor="@color/facefit_ink"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/processingBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/processing_analyzing_body"
                android:textColor="@color/facefit_ink_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/processingActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/processingRetakeButton"
                    style="@style/Widget.FaceFit.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:text="@string/processing_retake_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/processingPrimaryButton"
                    style="@style/Widget.FaceFit.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="@string/processing_continue_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
