<?xml version='1.0' encoding='utf-8'?>
<com.facefit.kiosk.ui.results.ResultsPanelLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_processing_canvas" android:padding="16dp" android:clipChildren="true" android:clipToPadding="true">
    <com.facefit.kiosk.ui.results.FittedProfilePanel android:id="@+id/resultsProfilePanel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_processing_panel" android:elevation="8dp" android:clipChildren="true" android:clipToPadding="true" android:clipToOutline="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:clipChildren="false" android:clipToPadding="false" android:id="@+id/resultsProfileContent">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/results_eyebrow" android:textColor="@color/facefit_teal" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.10" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/results_title" android:textColor="@color/facefit_ink" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/results_subtitle" android:textColor="@color/processing_text_secondary" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_results_soft" android:padding="16dp" android:clipChildren="false" android:clipToPadding="false" android:elevation="3dp">
                <FrameLayout android:layout_width="124dp" android:layout_height="124dp" android:padding="2dp" android:background="@drawable/bg_results_portrait_frame" android:elevation="4dp">
                    <ImageView android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/ic_results_face" android:contentDescription="@null" android:background="@drawable/bg_results_portrait" android:padding="0dp" android:elevation="0dp" android:scaleType="fitCenter" android:id="@+id/resultsFaceShapeImage" android:clipToOutline="true" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/results_shape_label" android:textSize="14sp" android:textColor="@color/processing_text_secondary" android:id="@+id/resultsShapeLabel" />
                    <TextView android:id="@+id/resultsFaceShapeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/results_shape_unavailable" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/facefit_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/results_shape_note" android:textSize="12sp" android:textColor="@color/processing_text_secondary" android:id="@+id/resultsShapeNote" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false" android:clipChildren="false" android:clipToPadding="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_results_soft" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:clipChildren="false" android:clipToPadding="false" android:elevation="3dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:minLines="2" android:text="@string/results_aspect_label" android:textSize="11sp" android:textColor="@color/processing_text_secondary" />
                    <TextView android:id="@+id/resultsAspectText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="@string/results_value_unavailable" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/facefit_ink" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_results_soft" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:clipChildren="false" android:clipToPadding="false" android:elevation="3dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:minLines="2" android:text="@string/results_jaw_label" android:textSize="11sp" android:textColor="@color/processing_text_secondary" />
                    <TextView android:id="@+id/resultsJawText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="@string/results_value_unavailable" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/facefit_ink" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_results_soft" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:clipChildren="false" android:clipToPadding="false" android:elevation="3dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:minLines="2" android:text="@string/results_eyes_label" android:textSize="11sp" android:textColor="@color/processing_text_secondary" />
                    <TextView android:id="@+id/resultsEyesText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="@string/results_value_unavailable" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/facefit_ink" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/bg_results_soft" android:padding="16dp" android:clipChildren="false" android:clipToPadding="false" android:elevation="3dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/results_profile_eyebrow" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="@color/facefit_teal" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/results_profile_title" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/facefit_ink" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/results_profile_body" android:lineSpacingExtra="3dp" android:textSize="13sp" android:textColor="@color/processing_text_secondary" android:id="@+id/resultsProfileSummary" android:maxLines="4" android:ellipsize="end" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/results_shape_explanation" android:textSize="12sp" android:textColor="@color/processing_text_secondary" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/resultsRescanButton" style="@style/Widget.FaceFit.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="@dimen/button_height" android:text="@string/results_rescan" />
        </LinearLayout>
    </com.facefit.kiosk.ui.results.FittedProfilePanel>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_processing_panel" android:padding="24dp" android:clipChildren="true" android:clipToPadding="true" android:elevation="8dp" android:id="@+id/resultsFramesPanel" android:clipToOutline="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/results_store_eyebrow" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.10" android:textColor="@color/facefit_teal" android:id="@+id/resultsInventoryLabel" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/results_matches_title" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/facefit_ink" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/results_matches_subtitle" android:textSize="14sp" android:textColor="@color/processing_text_secondary" android:id="@+id/resultsInventorySubtitle" />
        <ScrollView android:id="@+id/resultsFramesScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:fillViewport="true" android:clipChildren="true" android:clipToPadding="true" android:padding="8dp" android:scrollbars="vertical" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
                <LinearLayout android:id="@+id/resultsFrames" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="0dp" android:clipChildren="false" android:clipToPadding="false" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_results_soft" android:padding="28dp" android:clipChildren="false" android:clipToPadding="false" android:elevation="3dp" android:id="@+id/resultsEmptyMatches">
                    <ImageView android:layout_width="120dp" android:layout_height="60dp" android:src="@drawable/ic_results_frames" android:contentDescription="@null" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="20dp" android:text="@string/results_no_matches_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/facefit_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp" android:text="@string/results_no_matches_body" android:lineSpacingExtra="4dp" android:textSize="14sp" android:textColor="@color/processing_text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="20dp" android:text="@string/results_no_matches_note" android:textSize="12sp" android:textColor="@color/processing_text_secondary" android:id="@+id/resultsInventoryNote" />
                <com.google.android.material.button.MaterialButton style="@style/Widget.FaceFit.Button.Secondary" android:id="@+id/resultsFrameRetry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/frame_retry" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</com.facefit.kiosk.ui.results.ResultsPanelLayout>