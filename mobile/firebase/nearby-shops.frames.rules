// Add alongside existing helper functions inside /databases/{database}/documents.
function isPublishedShop(shopId) {
  return shopId is string
    && exists(/databases/$(database)/documents/publicShops/$(shopId))
    && get(/databases/$(database)/documents/publicShops/$(shopId)).data.status == "approved";
}

