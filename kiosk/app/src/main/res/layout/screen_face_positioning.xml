<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="560dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="1.45"
                android:background="@drawable/bg_teal_panel"
                android:elevation="8dp"
                android:minHeight="500dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/cameraStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_ready_pill"
                    android:text="@string/scan_status_ready"
                    android:textColor="@color/facefit_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/cameraPreviewPanel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_camera_preview"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="28dp">

                    <FrameLayout
                        android:id="@+id/faceGuide"
                        android:layout_width="220dp"
                        android:layout_height="310dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_face_guide"
                        android:elevation="8dp">

                        <View
                            android:layout_width="72dp"
                            android:layout_height="7dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="76dp"
                            android:layout_marginBottom="62dp"
                            android:background="@drawable/bg_face_line" />

                        <View
                            android:layout_width="72dp"
                            android:layout_height="7dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="76dp"
                            android:layout_marginBottom="62dp"
                            android:background="@drawable/bg_face_line" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_face_line"
                            android:alpha="0.6" />

                        <View
                            android:layout_width="88dp"
                            android:layout_height="4dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="116dp"
                            android:background="@drawable/bg_face_line"
                            android:alpha="0.6" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/cameraIssueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:maxWidth="360dp"
                        android:textColor="@color/facefit_ink"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/previewMessageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_preview_message_pill"
                        android:text="@string/scan_preview_ready"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="0.78"
                android:background="@drawable/bg_white_panel"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:minHeight="500dp"
                android:orientation="vertical"
                android:padding="38dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/scan_step_eyebrow"
                    android:textColor="@color/facefit_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/scan_title"
                    android:textColor="@color/facefit_ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/instructionBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/scan_body"
                    android:textColor="@color/facefit_ink_muted"
                    android:textSize="15sp" />

                <include
                    android:id="@+id/faceCenteredRow"
                    layout="@layout/view_scan_guidance_row"
                    android:layout_marginTop="22dp" />

                <include
                    android:id="@+id/lightingRow"
                    layout="@layout/view_scan_guidance_row"
                    android:layout_marginTop="16dp" />

                <include
                    android:id="@+id/positionRow"
                    layout="@layout/view_scan_guidance_row"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tipText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_scan_tip"
                    android:text="@string/scan_tip_ready"
                    android:textColor="@color/facefit_ink_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/captureButton"
                    style="@style/Widget.FaceFit.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="18dp"
                    android:text="@string/scan_capture_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

