<?xml version="1.0" encoding="utf-8"?>
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bg_processing_canvas"
  android:fillViewport="true">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">
    <LinearLayout
      android:layout_width="680dp"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="36dp"
      android:paddingBottom="36dp"
      android:background="@drawable/bg_processing_panel"
      android:padding="40dp"
      android:elevation="2dp">
      <FrameLayout
        android:id="@+id/processingProgressContainer"
        android:layout_width="132dp"
        android:layout_height="132dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator
          android:id="@+id/processingProgress"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:indeterminate="false"
          app:indicatorSize="128dp"
          app:indicatorInset="2dp"
          app:trackThickness="10dp"
          app:trackCornerRadius="5dp"
          app:indicatorColor="@color/processing_accent"
          app:trackColor="@color/processing_track"
          android:importantForAccessibility="no"
          android:max="100" />
        <TextView
          android:id="@+id/processingPercentText"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:text="@string/processing_percent_initial"
          android:textSize="26sp"
          android:fontFamily="sans-serif-medium"
          android:textColor="@color/processing_text"
          android:importantForAccessibility="no" />
      </FrameLayout>
      <TextView
        android:id="@+id/processingEyebrowText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:text="@string/processing_reference_eyebrow"
        android:textColor="@color/processing_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/processingTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:text="@string/processing_analyzing_title"
        android:textColor="@color/processing_text"
        android:textSize="28sp"
        android:accessibilityLiveRegion="polite"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/processingBodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="@string/processing_analyzing_body"
        android:textColor="@color/processing_text_secondary"
        android:textSize="16sp" />
      <LinearLayout
        android:id="@+id/processingStages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:padding="0dp">
        <com.google.android.material.progressindicator.LinearProgressIndicator
          android:id="@+id/processingLinearProgress"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:indeterminate="false"
          android:max="100"
          android:importantForAccessibility="no"
          app:indicatorColor="@color/processing_accent"
          app:trackColor="@color/processing_track"
          app:trackThickness="6dp"
          app:trackCornerRadius="3dp" />
        <TextView
          android:id="@+id/processingStatusText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/processing_status_landmarks"
          android:textColor="@color/processing_text_secondary"
          android:textSize="14sp"
          android:textStyle="normal"
          android:accessibilityLiveRegion="polite"
          android:gravity="center"
          android:layout_marginTop="12dp" />
      </LinearLayout>
      <TextView
        android:id="@+id/processingHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/processing_estimate_hint"
        android:textColor="@color/processing_text_secondary"
        android:textSize="11sp" />
      <LinearLayout
        android:id="@+id/processingActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
          android:id="@+id/processingPrimaryButton"
          style="@style/Widget.FaceFit.Button.Primary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="@dimen/button_height"
          android:text="@string/processing_continue_button" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/processingRetakeButton"
          style="@style/Widget.FaceFit.Button.Secondary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:minHeight="@dimen/button_height"
          android:text="@string/processing_retake_button"
          android:textColor="@color/processing_accent"
          app:strokeColor="@color/processing_accent" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</ScrollView>