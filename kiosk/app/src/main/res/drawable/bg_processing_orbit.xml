<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="120dp" android:startColor="#383FCBB9" android:endColor="#003FCBB9" />
            <stroke android:width="1dp" android:color="#406AE5D2" />
        </shape>
    </item>
    <item android:left="16dp" android:right="16dp" android:top="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#55103241" />
            <stroke android:width="1dp" android:color="#256AE5D2" />
        </shape>
    </item>
</layer-list>