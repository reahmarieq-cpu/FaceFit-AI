<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_teal_panel"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/compact_panel_padding">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/consent_privacy_eyebrow"
                    android:textColor="#9ED7DF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/consent_privacy_title"
                    android:textColor="@android:color/white"
                    android:textSize="38sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/consent_privacy_body"
                    android:textColor="#C7E4EA"
                    android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_panel"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/compact_panel_padding"
                android:layout_marginTop="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/consent_eyebrow"
                    android:textColor="@color/facefit_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/consent_title"
                    android:textColor="@color/facefit_ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/consent_body"
                    android:textColor="@color/facefit_ink_muted"
                    android:textSize="15sp" />
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/cameraAccessRow"
                    layout="@layout/view_consent_row"
                    android:layout_marginTop="22dp" />
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/facialProcessingRow"
                    layout="@layout/view_consent_row"
                    android:layout_marginTop="16dp" />
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/sessionDataRow"
                    layout="@layout/view_consent_row"
                    android:layout_marginTop="16dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/agreeButton"
                        style="@style/Widget.FaceFit.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/button_height"
                        android:minWidth="190dp"
                        android:text="@string/consent_agree_button"
                        android:layout_marginTop="10dp" />
                    <TextView
                        android:id="@+id/cancelButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/button_height"
                        android:background="@drawable/bg_outline_button"
                        android:gravity="center"
                        android:minWidth="120dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/consent_cancel_button"
                        android:textColor="@color/facefit_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>